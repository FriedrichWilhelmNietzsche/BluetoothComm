<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BluetoothComm"
             x:Class="BluetoothComm.MainPage"
             Title="蓝牙通讯"
             BackgroundColor="#F3F5F9">

    <ContentPage.Resources>
        <!-- 主题色 -->
        <Color x:Key="PrimaryBlue">#3B82F6</Color>
        <Color x:Key="LightBlue">#EAF1FE</Color>
        <Color x:Key="ConnectedGreen">#22C55E</Color>
        <Color x:Key="GrayEllipse">#C5CBD7</Color>
        <Color x:Key="TextMain">#1F2937</Color>
        <Color x:Key="TextSub">#8A94A6</Color>
        <Color x:Key="InputBg">#F7F8FB</Color>
        <Color x:Key="InputBorder">#E5E9F0</Color>

        <!-- 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#EDF0F5" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource TextSub}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <!-- 输入框容器 -->
        <Style x:Key="InputBoxStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
            <Setter Property="Stroke" Value="{StaticResource InputBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- ==================== 上半部分：蓝牙通讯（功能后续补充） ==================== -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <!-- 标题 -->
                    <Label Text="蓝牙通讯" Style="{StaticResource SectionTitleStyle}" />

                    <!-- 已连接设备显示：点击切换连接/断开；椭圆重叠=已连接，分开=未连接 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCommStatusTapped" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout x:Name="CommStatusIcon" Spacing="8" VerticalOptions="Center">
                            <Border x:Name="CommStatusEllipse1" WidthRequest="24" HeightRequest="14"
                                    StrokeShape="RoundRectangle 7" StrokeThickness="0"
                                    BackgroundColor="{StaticResource GrayEllipse}" />
                            <Border x:Name="CommStatusEllipse2" WidthRequest="24" HeightRequest="14"
                                    StrokeShape="RoundRectangle 7" StrokeThickness="0"
                                    BackgroundColor="{StaticResource GrayEllipse}" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label x:Name="CommStatusNameLabel" Text="未连接" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Label x:Name="CommStatusMacLabel" Text="点击此处开始扫描" FontSize="11" TextColor="{StaticResource TextSub}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 方式选择：输入 / 输出（Button，点击即发送对应指令） -->
                    <Label Text="方式选择" Style="{StaticResource FieldLabelStyle}" />
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button x:Name="InputTab" Text="输入" Clicked="OnInputTabClicked"
                                BackgroundColor="{StaticResource PrimaryBlue}" TextColor="White"
                                CornerRadius="8" Padding="24,6" FontSize="14" BorderWidth="0" />
                        <Button x:Name="OutputTab" Grid.Column="1" Text="输出" Clicked="OnOutputTabClicked"
                                BackgroundColor="White" TextColor="{StaticResource PrimaryBlue}"
                                CornerRadius="8" Padding="24,6" FontSize="14"
                                BorderColor="{StaticResource PrimaryBlue}" BorderWidth="1" />
                    </Grid>

                    <!-- 输入数值 -->
                    <Label Text="输入数值" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
                    <Border Style="{StaticResource InputBoxStyle}">
                        <Entry x:Name="InputEntry" Placeholder="输入总电量，如 334.12 或 500" PlaceholderColor="#B0B8C6"
                               Keyboard="Numeric" FontSize="15" BackgroundColor="Transparent" />
                    </Border>

                    <!-- 输出数值 -->
                    <Label Text="输出数值" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
                    <Border Style="{StaticResource InputBoxStyle}">
                        <Label x:Name="OutputLabel" Text="显示输出" TextColor="#B0B8C6" FontSize="15" />
                    </Border>

                    <!-- 通讯日志（TX/RX） -->
                    <Label Text="通讯记录" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                    <Border BackgroundColor="#F7F8FB" Stroke="#E5E9F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="10,8">
                        <ScrollView HeightRequest="130">
                            <Label x:Name="CommLogLabel" Text="—" TextColor="#4B5563" FontSize="12"
                                   FontFamily="Consolas" LineBreakMode="WordWrap" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ==================== 下半部分：设备扫描 ==================== -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="0">

                    <!-- 标题 + 扫描按钮 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="设备扫描" Style="{StaticResource SectionTitleStyle}" />
                        <Button x:Name="ScanButton" Grid.Column="1" Text="扫描"
                                Clicked="OnScanClicked"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White" FontSize="14" FontAttributes="Bold"
                                CornerRadius="18" HeightRequest="36" Padding="22,0" />
                    </Grid>

                    <!-- 连接状态：椭圆重叠=已连接，椭圆分开=未连接 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,16,0,0">
                        <HorizontalStackLayout x:Name="StatusIcon" Spacing="8" VerticalOptions="Center">
                            <Border x:Name="StatusEllipse1" WidthRequest="30" HeightRequest="18"
                                    StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                    BackgroundColor="{StaticResource GrayEllipse}" />
                            <Border x:Name="StatusEllipse2" WidthRequest="30" HeightRequest="18"
                                    StrokeShape="RoundRectangle 9" StrokeThickness="0"
                                    BackgroundColor="{StaticResource GrayEllipse}" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label x:Name="StatusLabel" Text="未连接" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                            <Label x:Name="StatusDetailLabel" Text="点击下方设备进行连接" FontSize="12" TextColor="{StaticResource TextSub}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 扫描结果列表 -->
                    <Label Text="扫描结果" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,8" />
                    <CollectionView x:Name="DeviceListView" SelectionMode="Single"
                                    SelectionChanged="OnDeviceSelected">
                        <CollectionView.EmptyView>
                            <Label Text="暂无设备，点击右上角「扫描」开始搜索"
                                   TextColor="{StaticResource TextSub}" FontSize="13"
                                   HorizontalOptions="Center" Margin="0,24" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceItem">
                                <Border BackgroundColor="White" Stroke="#EDF0F5" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12" Padding="12,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextMain}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding MacAddress}" FontSize="11" TextColor="{StaticResource TextSub}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="{Binding RssiText}" FontSize="11" TextColor="{StaticResource TextSub}" HorizontalOptions="End" />
                                            <!-- 设备连接状态：椭圆重叠=已连接，分开=未连接 -->
                                            <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                                <Border WidthRequest="22" HeightRequest="13"
                                                        StrokeShape="RoundRectangle 6.5" StrokeThickness="0"
                                                        BackgroundColor="{StaticResource GrayEllipse}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ConnectedGreen}" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <Border WidthRequest="22" HeightRequest="13"
                                                        StrokeShape="RoundRectangle 6.5" StrokeThickness="0"
                                                        BackgroundColor="{StaticResource GrayEllipse}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource ConnectedGreen}" />
                                                            <Setter Property="Margin" Value="-10,0,0,0" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
